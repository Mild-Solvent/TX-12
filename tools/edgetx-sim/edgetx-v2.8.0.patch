 }
 
 
+#if defined(SIMU)
+/* simu-headless: count the Lua heap and cap it like the radio's RAM */
+size_t simuLuaMem = 0, simuLuaMemPeak = 0, simuLuaMemCap = 0;
+unsigned simuLuaMemFail = 0;
+#endif
 void *l_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
   (void)ud; (void)osize;  /* not used */
+#if defined(SIMU)
+  size_t old = ptr ? osize : 0;
+  if (nsize == 0) {
+    if (ptr) { free(ptr); simuLuaMem -= old; }
+    return NULL;
+  }
+  if (simuLuaMemCap && nsize > old && simuLuaMem + (nsize - old) > simuLuaMemCap) {
+    simuLuaMemFail++;
+    return NULL;
+  }
+  void * p = realloc(ptr, nsize);
+  if (p) {
+    simuLuaMem = simuLuaMem - old + nsize;
+    if (simuLuaMem > simuLuaMemPeak) simuLuaMemPeak = simuLuaMem;
+  }
+  return p;
+#else
   if (nsize == 0) {
     if (ptr) {   // avoid a bunch of NULL pointer free calls
       // TRACE_LUA_INTERNALS("free %p", ptr); FLUSH();
@@ -965,6 +987,7 @@ void *l_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
   }
   else
     return realloc(ptr, nsize);
+#endif
 }
 
 
