--- a/radio/src/lua/interface.cpp
+++ b/radio/src/lua/interface.cpp
@@ -123,8 +123,40 @@ int custom_lua_atpanic(lua_State * L)
   return 0;
 }
 
+#if defined(SIMU)
+// simu-headless instrumentation: report Lua code running inside a C call
+// (a radio yield there fails with "attempt to yield across a C-call boundary")
+// and optionally yield after a fixed instruction budget to model the radio's CPU.
+#include "lstate.h"
+unsigned simuLuaCBoundaryHits = 0, simuLuaBudgetYields = 0, simuLuaMaxCycleInstr = 0, simuLuaBudget = 0;
+char simuLuaCBoundaryWhere[256] = "";
+static tmr10ms_t simuCycle = 0;
+static unsigned simuCycleInstr = 0;
+#endif
+
 static void luaHook(lua_State * L, lua_Debug *ar)
 {
+#if defined(SIMU)
+  if (ar->event == LUA_HOOKCALL) {
+    if (L->nny > 0 && lua_getinfo(L, "Sl", ar) && ar->what[0] == 'L') {
+      if (!simuLuaCBoundaryHits)
+        snprintf(simuLuaCBoundaryWhere, sizeof(simuLuaCBoundaryWhere), "%s:%d (Lua function called from C)", ar->short_src, ar->linedefined);
+      simuLuaCBoundaryHits++;
+    }
+    return;
+  }
+  if (ar->event == LUA_HOOKCOUNT) {
+    if (luaCycleStart != simuCycle) { simuCycle = luaCycleStart; simuCycleInstr = 0; }
+    simuCycleInstr += PERMANENT_SCRIPTS_MAX_INSTRUCTIONS;
+    if (simuCycleInstr > simuLuaMaxCycleInstr) simuLuaMaxCycleInstr = simuCycleInstr;
+    if (simuLuaBudget && simuCycleInstr >= simuLuaBudget) {
+      simuLuaBudgetYields++;
+      simuCycleInstr = 0;
+      lua_yield(lsScripts, 0);
+      return;
+    }
+  }
+#endif
   if (ar->event == LUA_HOOKCOUNT) {
     if (get_tmr10ms() - luaCycleStart >= LUA_TASK_PERIOD_TICKS) {
       lua_yield(lsScripts, 0);
@@ -1274,8 +1306,12 @@ void luaInit()
 
 #if defined(LUA_ALLOCATOR_TRACER)
       lua_sethook(L, luaHook, LUA_MASKCOUNT|LUA_MASKLINE, PERMANENT_SCRIPTS_MAX_INSTRUCTIONS);
+#else
+#if defined(SIMU)
+      lua_sethook(L, luaHook, LUA_MASKCOUNT|LUA_MASKCALL, PERMANENT_SCRIPTS_MAX_INSTRUCTIONS);
 #else
       lua_sethook(L, luaHook, LUA_MASKCOUNT, PERMANENT_SCRIPTS_MAX_INSTRUCTIONS);
+#endif
 #endif
 
       // lsScripts is now a coroutine in lieu of the main thread to support preemption
